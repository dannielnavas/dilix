---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].faq;
---

<section id="faq" class="py-24 relative overflow-hidden bg-[#060911]">
  <!-- Subtle ambient glow in background (No purple/indigo) -->
  <div class="absolute bottom-0 right-1/4 w-[500px] h-[300px] glow-cyan rounded-full blur-3xl pointer-events-none -z-10 opacity-20"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        {t.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {t.title}
      </h2>
      <p class="mt-4 text-slate-400 text-base">
        {t.subtitle}
      </p>
    </div>

    <!-- Minimalist Accordion List (Dividers instead of nested boxes) -->
    <div class="divide-y divide-slate-800/80 border-y border-slate-800/80">
      {t.items.map((faq, index) => (
        <div class="faq-item group transition-colors">
          <button
            type="button"
            class="faq-trigger w-full py-6 text-left flex items-center justify-between gap-4 cursor-pointer hover:text-emerald-400 transition-colors"
            data-index={index}
          >
            <span class="font-bold text-white group-hover:text-emerald-300 text-base sm:text-lg transition-colors pr-2">
              {faq.q}
            </span>
            <span class="faq-icon shrink-0 w-8 h-8 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 group-hover:text-emerald-400 group-hover:border-emerald-500/40 transition-all duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </button>
          <div class="faq-content hidden pb-6 text-slate-300 text-sm sm:text-base leading-relaxed">
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll('.faq-trigger');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const parent = trigger.closest('.faq-item');
      if (!parent) return;

      const content = parent.querySelector('.faq-content');
      const icon = trigger.querySelector('.faq-icon');
      const isOpen = !content?.classList.contains('hidden');

      // Close all others
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => {
        i.classList.remove('rotate-180', 'text-emerald-400', 'border-emerald-500/40');
      });

      // Toggle current
      if (!isOpen && content && icon) {
        content.classList.remove('hidden');
        icon.classList.add('rotate-180', 'text-emerald-400', 'border-emerald-500/40');
      }
    });
  });
</script>
