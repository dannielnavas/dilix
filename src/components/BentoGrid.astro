---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].bento;
---

<section id="caracteristicas" class="py-24 relative overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute bottom-10 left-10 w-[500px] h-[400px] glow-purple rounded-full blur-3xl pointer-events-none -z-10 opacity-50"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        {t.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        {t.title} <span class="bg-gradient-to-r from-cyan-400 to-indigo-400 bg-clip-text text-transparent">{t.titleGradient}</span>
      </h2>
      <p class="mt-4 text-slate-400 text-base sm:text-lg">
        {t.subtitle}
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Card 01: Dilix Copilot (Destacada - 8 cols on md) -->
      <div class="md:col-span-12 lg:col-span-8 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111625] to-[#0c101c] border border-indigo-500/30 hover:border-indigo-500/60 shadow-xl relative overflow-hidden group transition-all">
        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl group-hover:bg-indigo-500/20 transition-all"></div>
        
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold text-indigo-400 px-2.5 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20">
            {t.c1.tag}
          </span>
          <span class="text-xs text-emerald-400 font-mono flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> {t.c1.status}
          </span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
          {t.c1.title}
        </h3>

        <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
          {t.c1.desc}
        </p>

        <!-- Visual simulation inside card -->
        <div class="mt-6 p-4 rounded-xl bg-[#070b14] border border-slate-800 font-mono text-xs text-slate-300 space-y-2">
          <div class="flex items-center justify-between text-[11px] text-slate-500 border-b border-slate-800 pb-2">
            <span>{t.c1.engine}</span>
            <span class="text-cyan-400">{t.c1.ram}</span>
          </div>
          <div class="text-indigo-300">{t.c1.query}</div>
          <div class="text-slate-400 pl-2 border-l-2 border-indigo-500/50 text-[11px] py-1">
            {t.c1.output}
          </div>
        </div>
      </div>

      <!-- Card 02: Autodiagnóstico con Ctrl + G (4 cols on lg) -->
      <div class="md:col-span-6 lg:col-span-4 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111625] to-[#0c101c] border border-slate-800 hover:border-cyan-500/40 shadow-xl relative overflow-hidden group transition-all">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold text-cyan-400 px-2.5 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/20">
            {t.c2.tag}
          </span>
          <kbd class="px-2 py-0.5 text-xs font-mono bg-slate-800 text-slate-300 rounded border border-slate-700 shadow-sm">Ctrl + G</kbd>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
          {t.c2.title}
        </h3>

        <p class="mt-3 text-slate-300 text-xs sm:text-sm leading-relaxed">
          {t.c2.desc}
        </p>

        <div class="mt-5 p-3 rounded-xl bg-[#070b14] border border-rose-500/20 text-xs font-mono space-y-1.5">
          <div class="text-rose-400">✗ git push -> Permission denied (publickey)</div>
          <div class="text-emerald-400 text-[11px]">✓ fix: ssh-add ~/.ssh/id_ed25519</div>
        </div>
      </div>

      <!-- Card 03: Estética Visual Premium (4 cols on lg) -->
      <div class="md:col-span-6 lg:col-span-4 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111625] to-[#0c101c] border border-slate-800 hover:border-purple-500/40 shadow-xl relative overflow-hidden group transition-all">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold text-purple-400 px-2.5 py-1 rounded-md bg-purple-500/10 border border-purple-500/20">
            {t.c3.tag}
          </span>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
          {t.c3.title}
        </h3>

        <p class="mt-3 text-slate-300 text-xs sm:text-sm leading-relaxed">
          {t.c3.desc}
        </p>

        <div class="mt-5 flex items-center gap-2 text-xs font-mono">
          <span class="px-2 py-1 rounded bg-slate-800/80 text-purple-300 border border-slate-700">Tokyo Night</span>
          <span class="px-2 py-1 rounded bg-slate-800/80 text-cyan-300 border border-slate-700">Starship v1.21</span>
          <span class="px-2 py-1 rounded bg-slate-800/80 text-emerald-300 border border-slate-700">Nerd Fonts</span>
        </div>
      </div>

      <!-- Card 04: Soporte Nativo 4 en 1 (4 cols on lg) -->
      <div class="md:col-span-6 lg:col-span-4 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111625] to-[#0c101c] border border-slate-800 hover:border-amber-500/40 shadow-xl relative overflow-hidden group transition-all">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold text-amber-400 px-2.5 py-1 rounded-md bg-amber-500/10 border border-amber-500/20">
            {t.c4.tag}
          </span>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
          {t.c4.title}
        </h3>

        <p class="mt-3 text-slate-300 text-xs sm:text-sm leading-relaxed">
          {t.c4.desc}
        </p>

        <div class="mt-5 grid grid-cols-2 gap-2 text-[11px] font-mono text-slate-400">
          <div class="p-2 rounded bg-[#070b14] border border-slate-800 text-center">macOS • Homebrew</div>
          <div class="p-2 rounded bg-[#070b14] border border-slate-800 text-center">CachyOS • AUR/Paru</div>
          <div class="p-2 rounded bg-[#070b14] border border-slate-800 text-center">Ubuntu • APT/PPA</div>
          <div class="p-2 rounded bg-[#070b14] border border-slate-800 text-center">WSL2 • WinBridge</div>
        </div>
      </div>

      <!-- Card 05: Arquitectura Modular Zsh (4 cols on lg) -->
      <div class="md:col-span-6 lg:col-span-4 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-[#111625] to-[#0c101c] border border-slate-800 hover:border-emerald-500/40 shadow-xl relative overflow-hidden group transition-all">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono font-bold text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
            {t.c5.tag}
          </span>
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
          {t.c5.title}
        </h3>

        <p class="mt-3 text-slate-300 text-xs sm:text-sm leading-relaxed">
          {t.c5.desc}
        </p>

        <div class="mt-5 p-2.5 rounded-xl bg-[#070b14] border border-slate-800 font-mono text-[11px] text-slate-300">
          <span class="text-slate-500"># Easy integration:</span><br/>
          <span class="text-emerald-400">plugins=(... dilix)</span>
        </div>
      </div>

    </div>
  </div>
</section>
