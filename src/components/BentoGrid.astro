---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].bento;
---

<section id="caracteristicas" class="py-24 relative overflow-hidden">
  <!-- Subtle ambient glow in background (No purple/indigo) -->
  <div class="absolute top-1/4 -left-20 w-[600px] h-[500px] glow-emerald rounded-full blur-3xl pointer-events-none -z-10 opacity-40"></div>
  <div class="absolute bottom-10 right-0 w-[500px] h-[400px] glow-cyan rounded-full blur-3xl pointer-events-none -z-10 opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (Clean Typographic Rhythm) -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        {t.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {t.title} <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">{t.titleGradient}</span>
      </h2>
      <p class="mt-4 text-slate-300 text-base sm:text-lg leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Editorial Showcase Layout -->
    <div class="space-y-12">
      
      <!-- Feature 01: Nacel Copilot Local AI (Hero Split Layout) -->
      <div class="rounded-3xl bg-gradient-to-b from-[#0e1424] to-[#0a0e1a] border border-slate-800/90 p-6 sm:p-10 lg:p-12 shadow-2xl overflow-hidden relative">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Text column -->
          <div class="lg:col-span-5 space-y-5">
            <div class="flex items-center gap-3">
              <span class="text-xs font-mono font-bold text-emerald-400 px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20">
                {t.c1.tag}
              </span>
              <span class="text-xs text-emerald-400 font-mono flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> {t.c1.status}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              {t.c1.title}
            </h3>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              {t.c1.desc}
            </p>

            <!-- Key Benefits Checklist -->
            <ul class="space-y-2.5 pt-2 text-xs sm:text-sm text-slate-300 font-mono">
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{lang === 'en' ? 'Hardware-tuned: llama3.2:1b & qwen2.5-coder' : 'Calibrado a tu RAM: llama3.2:1b & qwen2.5-coder'}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{lang === 'en' ? 'Zero cloud telemetry: 100% private IPC communication' : 'Cero telemetría: Comunicación IPC 100% en tu máquina'}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{lang === 'en' ? 'Under 200ms latency on Apple Silicon & Intel/AMD' : 'Latencia menor a 200ms en Apple Silicon e Intel/AMD'}</span>
              </li>
            </ul>
          </div>

          <!-- Media column: Real terminal recording -->
          <div class="lg:col-span-7">
            <div class="rounded-2xl overflow-hidden border border-slate-800 bg-[#16161e] shadow-2xl">
              <div class="bg-[#1a1b26] px-4 py-2.5 border-b border-slate-800 flex items-center justify-between text-xs font-mono text-slate-400">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
                  <span class="ml-2 text-slate-300">nacel explain</span>
                </div>
                <span class="text-emerald-400 text-[11px]">Tokyo Night</span>
              </div>
              <img
                src={`/${lang}/feature-explain.gif`}
                alt={lang === 'en' ? 'Nacel code and command explanation real terminal recording' : 'Grabación real de explicación de código y comandos con Nacel'}
                class="w-full h-auto block select-none"
                loading="lazy"
                width="1200"
                height="680"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 02 & 03: Two Balanced Pillars (Diagnóstico Cero Ruido & Centro de Control) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Pillar 02: Diagnóstico Quirúrgico de Errores (Zero-Pollution Error Context) -->
        <div class="rounded-3xl bg-[#0b0f1a] border border-slate-800/80 p-6 sm:p-8 flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-cyan-400 px-2.5 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/20">
                {t.c2.tag}
              </span>
              <kbd class="px-2.5 py-1 text-xs font-mono bg-slate-800 text-emerald-300 rounded-md border border-emerald-500/30 shadow-sm font-semibold">Ctrl + G</kbd>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              {t.c2.title}
            </h3>

            <p class="text-slate-300 text-sm leading-relaxed">
              {t.c2.desc}
            </p>

            <!-- 3 Highlights requested by user -->
            <div class="space-y-2.5 pt-2 text-xs">
              <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0">✅</span>
                <div>
                  <span class="font-bold text-white">{t.c2.badgeError}:</span>
                  <span class="text-slate-400 ml-1">{t.c2.descError}</span>
                </div>
              </div>
              <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-2.5">
                <span class="text-cyan-400 font-bold shrink-0">✅</span>
                <div>
                  <span class="font-bold text-white">{t.c2.badgeScrollback}:</span>
                  <span class="text-slate-400 ml-1">{t.c2.descScrollback}</span>
                </div>
              </div>
              <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start gap-2.5">
                <span class="text-amber-400 font-bold shrink-0">✅</span>
                <div>
                  <span class="font-bold text-white">{t.c2.badgePipes}:</span>
                  <code class="text-emerald-300 font-mono text-[11px] ml-1 bg-black/40 px-1.5 py-0.5 rounded">{t.c2.descPipes}</code>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-6 rounded-2xl overflow-hidden border border-slate-800/80 bg-[#16161e] shadow-lg">
            <img
              src={`/${lang}/feature-fix.gif`}
              alt={lang === 'en' ? 'Nacel error auto-diagnosis real terminal recording' : 'Grabación real de autodiagnóstico de error en terminal con Nacel'}
              class="w-full h-auto block select-none"
              loading="lazy"
              width="1200"
              height="680"
            />
          </div>
        </div>

        <!-- Pillar 03: Centro de Control nacel menu -->
        <div class="rounded-3xl bg-[#0b0f1a] border border-slate-800/80 p-6 sm:p-8 flex flex-col justify-between hover:border-cyan-500/40 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-cyan-400 px-2.5 py-1 rounded-md bg-cyan-500/10 border border-cyan-500/20">
                {t.c3.tag}
              </span>
              <kbd class="px-2.5 py-1 text-xs font-mono bg-slate-800 text-cyan-300 rounded-md border border-cyan-500/30 shadow-sm font-semibold">nacel menu</kbd>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              {t.c3.title}
            </h3>

            <p class="text-slate-300 text-sm leading-relaxed">
              {t.c3.desc}
            </p>
          </div>

          <div class="mt-6 rounded-2xl overflow-hidden border border-slate-800/80 bg-[#16161e] shadow-lg">
            <img
              src={`/${lang}/feature-menu.gif`}
              alt={lang === 'en' ? 'Nacel interactive CLI menu real terminal recording' : 'Grabación real del centro de control nacel menu'}
              class="w-full h-auto block select-none"
              loading="lazy"
              width="1200"
              height="680"
            />
          </div>
        </div>
      </div>

      <!-- Features 04, 05, 06: Triad of Engineering Excellence -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        
        <!-- 04: Visual Aesthetics -->
        <div class="p-6 rounded-2xl bg-[#080d17]/60 border border-slate-800/80 hover:border-slate-700 transition-colors space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-cyan-400 font-semibold">{t.c4.tag}</span>
            <span class="text-xs font-mono text-slate-400 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Tokyo Night
            </span>
          </div>
          <h4 class="text-lg font-bold text-white tracking-tight">{t.c4.title}</h4>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{t.c4.desc}</p>
          <div class="pt-2 text-xs font-mono text-slate-500 flex items-center gap-2">
            <span>✨ WezTerm GPU</span>
            <span>•</span>
            <span>🚀 Starship Prompt</span>
          </div>
        </div>

        <!-- 05: Native Interop -->
        <div class="p-6 rounded-2xl bg-[#080d17]/60 border border-slate-800/80 hover:border-slate-700 transition-colors space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-emerald-400 font-semibold">{t.c5.tag}</span>
            <span class="text-xs font-mono text-slate-400">4-in-1 Native</span>
          </div>
          <h4 class="text-lg font-bold text-white tracking-tight">{t.c5.title}</h4>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{t.c5.desc}</p>
          <div class="pt-2 text-xs font-mono text-slate-500 flex flex-wrap gap-2">
            <span class="text-emerald-400">macOS (brew)</span>
            <span>•</span>
            <span class="text-cyan-400">CachyOS</span>
            <span>•</span>
            <span class="text-slate-300">Ubuntu</span>
            <span>•</span>
            <span class="text-amber-400">WSL2</span>
          </div>
        </div>

        <!-- 06: Multi-Shell Native -->
        <div class="p-6 rounded-2xl bg-[#080d17]/60 border border-slate-800/80 hover:border-slate-700 transition-colors space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-emerald-400 font-semibold">{t.c6.tag}</span>
            <span class="text-xs font-mono text-emerald-400">Zsh • Fish • Bash</span>
          </div>
          <h4 class="text-lg font-bold text-white tracking-tight">{t.c6.title}</h4>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">{t.c6.desc}</p>
          <div class="pt-2 text-xs font-mono text-emerald-400/90 bg-slate-900/80 px-3 py-1.5 rounded-lg border border-slate-800 flex items-center justify-between">
            <code>plugins=(... nacel)</code>
            <span class="text-[11px] text-slate-500">Zero startup lag</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
