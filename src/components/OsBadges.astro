---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].osBadges;

const icons: Record<string, string> = {
  macOS: `<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.56-.69.94-1.64.84-2.6-.82.03-1.82.55-2.4 1.23-.51.6-.96 1.57-.84 2.5.92.07 1.86-.47 2.4-1.13z"/>`,
  CachyOS: `<path d="M12 2L2 20h4l6-11 6 11h4L12 2zm0 8l-2.5 4.5h5L12 10z"/>`,
  Ubuntu: `<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>`,
  WSL2: `<path d="M3 5.5L10.5 4.5v7.2L3 11.6V5.5zm8.5-1.3L21 2.8v8.8l-9.5.1V4.2zM3 12.6l7.5-.1v7.3L3 18.6v-6zm8.5.1l9.5.1v8.8l-9.5-1.4v-7.5z"/>`
};
---

<section class="py-10 border-y border-slate-800/60 bg-[#070a12]/70 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-6">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
        {t.header}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {t.platforms.map((p) => (
        <div class="relative group p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/40 hover:bg-slate-900/90 transition-all">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2.5">
              <svg class="w-5 h-5 text-indigo-400 fill-current" viewBox="0 0 24 24" set:html={icons[p.name] || icons.Ubuntu} />
              <h3 class="font-bold text-white text-base">{p.name}</h3>
            </div>
            <span class="font-mono text-[11px] px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
              {p.flag}
            </span>
          </div>

          <div class="text-xs font-medium text-cyan-300/90 mb-1.5 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            {p.badge}
          </div>

          <p class="text-xs text-slate-400 leading-relaxed">
            {p.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
