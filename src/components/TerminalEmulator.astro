    <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 cursor-pointer hover:bg-slate-700">[P]ersonalizar Prompt</span>
    <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 cursor-pointer hover:bg-slate-700">[C]opiar al Portapapeles</span>
  </div>
</div>
`,
    fix: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/dotfiles</span> <span class="text-emerald-400">❯</span>
  <span class="text-rose-400 font-normal">git push origin main</span>
</div>
<div class="text-rose-400 text-xs bg-rose-950/30 border border-rose-800/40 p-2.5 rounded-lg my-1">
  git@github.com: Permission denied (publickey).<br/>
  fatal: Could not read from remote repository.
</div>
<div class="flex items-center gap-2 text-indigo-400 font-bold mt-3">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/dotfiles</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">fix</span>
</div>
<div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/40 space-y-2 mt-2">
  <div class="text-cyan-400 font-bold text-xs flex items-center gap-2">
    <span>⚡</span> Diagnóstico Dilix: Clave SSH no cargada en ssh-agent
  </div>
  <p class="text-slate-300 text-xs">
    Tu agente SSH no tiene tu clave cargada en memoria para autenticar con GitHub.
  </p>
  <div class="bg-[#050811] p-2.5 rounded-lg border border-slate-800 text-emerald-400 font-mono text-xs">
    eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519
  </div>
  <div class="text-[11px] text-slate-400">
    Presiona <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200">Enter</kbd> para ejecutar el arreglo y reintentar el push de forma segura.
  </div>
</div>
`,
    menu: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">dilix menu</span>
</div>
<div class="p-4 rounded-xl bg-[#060912] border border-indigo-500/30 text-xs space-y-2 font-mono">
  <div class="text-indigo-400 font-bold">╭─ Dilix Interactive CLI Hub (v1.4.2) ─────────────╮</div>
  <div class="text-slate-300 pl-2">Selecciona una acción con las flechas [↑/↓]:</div>
  <div class="space-y-1 pl-4 pt-1">
    <div class="text-cyan-300 font-bold">● [1] Consultar Asistente de IA (ask)</div>
    <div class="text-slate-400">○ [2] Analizar último error de terminal (fix)</div>
    <div class="text-slate-400">○ [3] Administrar Modelos de Ollama (qwen, deepseek, llama3)</div>
    <div class="text-slate-400">○ [4] Cambiar Idioma (Español / English)</div>
    <div class="text-slate-400">○ [5] Diagnóstico de Enlaces Simbólicos (~/dotfiles)</div>
    <div class="text-slate-400">○ [6] Salir</div>
  </div>
  <div class="text-indigo-400 font-bold">╰──────────────────────────────────────────────────╯</div>
</div>
`,
    ff: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">ff</span>
</div>
<div class="p-4 rounded-xl bg-[#060912] border border-slate-800 text-xs font-mono grid grid-cols-1 md:grid-cols-12 gap-3">
  <div class="md:col-span-5 text-cyan-400 font-bold leading-tight select-none">
<pre>
       /\
      /  \
     /\   \
    /      \
   /   ,,   \
  /   |  |  -\
 /_-''    ''-_\\
</pre>
    <div class="text-[10px] text-indigo-400 mt-1">sqlsec/fastfetch dynamic logo</div>
  </div>
  <div class="md:col-span-7 space-y-1 text-slate-300 text-xs">
    <div><span class="text-indigo-400 font-bold">OS:</span> macOS Sequoia 15.3.1 (Darwin 24.3.0)</div>
    <div><span class="text-indigo-400 font-bold">Host:</span> Apple Silicon M-Series</div>
    <div><span class="text-indigo-400 font-bold">Uptime:</span> 4 days, 6 hours, 28 mins</div>
    <div><span class="text-indigo-400 font-bold">Packages:</span> 142 (brew), 8 (cargo)</div>
    <div><span class="text-indigo-400 font-bold">Shell:</span> zsh 5.9 with Starship + Dilix AI</div>
    <div><span class="text-indigo-400 font-bold">Terminal:</span> WezTerm 20240203 (Tokyo Night)</div>
    <div><span class="text-indigo-400 font-bold">Memory:</span> 4.12 GiB / 36.00 GiB (11%)</div>
  </div>
</div>
`
  };

  const demoOutputsEn = {
    ask: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/projects</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">ask "find files modified in the last 24 hours"</span>
</div>
<div class="p-4 rounded-xl bg-slate-900/90 border border-indigo-500/40 space-y-3 mt-2 shadow-lg">
  <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
    <span class="text-cyan-400 font-bold flex items-center gap-2">
      <span>🧠</span> Dilix Copilot • qwen2.5-coder:1.5b
    </span>
    <span class="text-[11px] text-slate-400">Latency: 180ms • Local IPC</span>
  </div>
  <p class="text-slate-300">
    Optimized command using <span class="text-cyan-300 font-semibold">find</span> with relative timestamp filter:
  </p>
  <div class="bg-[#050811] p-3 rounded-lg border border-slate-800 text-emerald-400 font-mono text-sm flex items-center justify-between">
    <code>find . -maxdepth 2 -mtime -1 -type f</code>
    <span class="text-[11px] text-slate-500">[24h / depth 2]</span>
  </div>
  <div class="flex items-center gap-2 text-xs pt-1">
    <span class="px-2.5 py-1 rounded bg-indigo-600 text-white font-semibold cursor-pointer hover:bg-indigo-500">[E]xecute directly</span>
    <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 cursor-pointer hover:bg-slate-700">[P]ersonalize Prompt</span>
    <span class="px-2.5 py-1 rounded bg-slate-800 text-slate-300 cursor-pointer hover:bg-slate-700">[C]opy to Clipboard</span>
  </div>
</div>
`,
    fix: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/dotfiles</span> <span class="text-emerald-400">❯</span>
  <span class="text-rose-400 font-normal">git push origin main</span>
</div>
<div class="text-rose-400 text-xs bg-rose-950/30 border border-rose-800/40 p-2.5 rounded-lg my-1">
  git@github.com: Permission denied (publickey).<br/>
  fatal: Could not read from remote repository.
</div>
<div class="flex items-center gap-2 text-indigo-400 font-bold mt-3">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/dotfiles</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">fix</span>
</div>
<div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/40 space-y-2 mt-2">
  <div class="text-cyan-400 font-bold text-xs flex items-center gap-2">
    <span>⚡</span> Dilix Diagnostic: SSH key not loaded in ssh-agent
  </div>
  <p class="text-slate-300 text-xs">
    Your current SSH agent doesn't have your private key loaded in memory for GitHub authentication.
  </p>
  <div class="bg-[#050811] p-2.5 rounded-lg border border-slate-800 text-emerald-400 font-mono text-xs">
    eval "$(ssh-agent -s)" && ssh-add ~/.ssh/id_ed25519
  </div>
  <div class="text-[11px] text-slate-400">
    Press <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200">Enter</kbd> to execute this fix and safely retry the push.
  </div>
</div>
`,
    menu: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">dilix menu</span>
</div>
<div class="p-4 rounded-xl bg-[#060912] border border-indigo-500/30 text-xs space-y-2 font-mono">
  <div class="text-indigo-400 font-bold">╭─ Dilix Interactive CLI Hub (v1.4.2) ─────────────╮</div>
  <div class="text-slate-300 pl-2">Select an action using arrow keys [↑/↓]:</div>
  <div class="space-y-1 pl-4 pt-1">
    <div class="text-cyan-300 font-bold">● [1] Query AI Assistant (ask)</div>
    <div class="text-slate-400">○ [2] Diagnose last shell error (fix)</div>
    <div class="text-slate-400">○ [3] Manage Ollama Models (qwen, deepseek, llama3)</div>
    <div class="text-slate-400">○ [4] Switch Language (English / Español)</div>
    <div class="text-slate-400">○ [5] Check Symlink Integrity (~/dotfiles)</div>
    <div class="text-slate-400">○ [6] Exit</div>
  </div>
  <div class="text-indigo-400 font-bold">╰──────────────────────────────────────────────────╯</div>
</div>
`,
    ff: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">ff</span>
</div>
<div class="p-4 rounded-xl bg-[#060912] border border-slate-800 text-xs font-mono grid grid-cols-1 md:grid-cols-12 gap-3">
  <div class="md:col-span-5 text-cyan-400 font-bold leading-tight select-none">
<pre>
       /\
      /  \
     /\   \
    /      \
   /   ,,   \
  /   |  |  -\
 /_-''    ''-_\\
</pre>
    <div class="text-[10px] text-indigo-400 mt-1">sqlsec/fastfetch dynamic logo</div>
  </div>
  <div class="md:col-span-7 space-y-1 text-slate-300 text-xs">
    <div><span class="text-indigo-400 font-bold">OS:</span> macOS Sequoia 15.3.1 (Darwin 24.3.0)</div>
    <div><span class="text-indigo-400 font-bold">Host:</span> Apple Silicon M-Series</div>
    <div><span class="text-indigo-400 font-bold">Uptime:</span> 4 days, 6 hours, 28 mins</div>
    <div><span class="text-indigo-400 font-bold">Packages:</span> 142 (brew), 8 (cargo)</div>
    <div><span class="text-indigo-400 font-bold">Shell:</span> zsh 5.9 with Starship + Dilix AI</div>
    <div><span class="text-indigo-400 font-bold">Terminal:</span> WezTerm 20240203 (Tokyo Night)</div>
    <div><span class="text-indigo-400 font-bold">Memory:</span> 4.12 GiB / 36.00 GiB (11%)</div>
  </div>
</div>
`
  };

  const demoOutputs = currentLang === 'en' ? demoOutputsEn : demoOutputsEs;
  const screen = document.getElementById('terminal-screen');
  const cmdBtns = document.querySelectorAll('.demo-cmd-btn');
  const clearBtn = document.getElementById('demo-clear-btn');
  const customInput = document.getElementById('terminal-custom-input');
  const copyOutputBtn = document.getElementById('demo-copy-output');
  const copyFeedback = document.getElementById('demo-copy-feedback');

  function renderCommand(cmdKey) {
    if (!screen) return;
    const content = demoOutputs[cmdKey] || `
      <div class="text-rose-400 text-xs">Command not recognized: ${cmdKey}. Try 'ask', 'fix', 'menu', or 'ff'.</div>
    `;
    screen.innerHTML = content;
    screen.scrollTop = screen.scrollHeight;
  }

  // Initial load
  renderCommand('ask');

  // Button clicks
  cmdBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      cmdBtns.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-600/30');
        b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-800');
      });
      btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-600/30');
      btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-800');

      const cmd = btn.getAttribute('data-demo-cmd');
      if (cmd) renderCommand(cmd);
    });
  });

  // Clear button
  if (clearBtn && screen) {
    clearBtn.addEventListener('click', () => {
      screen.innerHTML = `
        <div class="text-slate-500 text-xs font-mono">${currentLang === 'en' ? 'Terminal cleared. Click a command above or type below.' : 'Terminal limpio. Haz clic en un comando arriba o escribe abajo.'}</div>
      `;
    });
  }

  // Interactive input Enter handler
  if (customInput) {
    customInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = customInput.value.trim().toLowerCase();
        if (!val) return;

        if (val.includes('ask')) renderCommand('ask');
        else if (val.includes('fix')) renderCommand('fix');
        else if (val.includes('menu')) renderCommand('menu');
        else if (val.includes('ff') || val.includes('fastfetch')) renderCommand('ff');
        else if (val === 'clear') {
          if (screen) screen.innerHTML = `<div class="text-slate-500 text-xs">Terminal cleared.</div>`;
        } else {
          renderCommand('ask');
        }
        customInput.value = '';
      }
    });
  }

  // Copy output
  if (copyOutputBtn && copyFeedback && screen) {
    copyOutputBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(screen.innerText);
        copyFeedback.textContent = copiedLabel;
        setTimeout(() => {
          copyFeedback.textContent = copyLabel;
        }, 2000);
      } catch (err) {
        console.error('Error copying text:', err);
      }
    });
  }
</script>
