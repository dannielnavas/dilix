---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].demo;
---

<section id="demo" class="py-24 relative overflow-hidden bg-[#060911]">
  <!-- Subtle ambient glow in background (No purple/indigo) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] glow-emerald rounded-full blur-3xl pointer-events-none -z-10 opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        {t.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        {t.title}
      </h2>
      <p class="mt-4 text-slate-400 text-base sm:text-lg">
        {t.subtitle}
      </p>

      <!-- Command Quick Selection Buttons (Clean pills) -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
        <button
          type="button"
          data-demo-cmd="ask"
          class="demo-cmd-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-mono transition-all cursor-pointer bg-emerald-500 text-slate-950 font-bold border border-emerald-400 shadow-md shadow-emerald-500/20"
        >
          {t.btnAsk}
        </button>
        <button
          type="button"
          data-demo-cmd="fix"
          class="demo-cmd-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnFix}
        </button>
        <button
          type="button"
          data-demo-cmd="menu"
          class="demo-cmd-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnMenu}
        </button>
        <button
          type="button"
          data-demo-cmd="ff"
          class="demo-cmd-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnFf}
        </button>
        <button
          type="button"
          data-demo-cmd="explain"
          class="demo-cmd-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900/80 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnExplain}
        </button>
        <button
          type="button"
          id="demo-clear-btn"
          class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border border-rose-500/20 text-rose-400 hover:bg-rose-500/10 transition-all cursor-pointer"
        >
          {t.btnClear}
        </button>
      </div>
    </div>

    <!-- Terminal Window Container (Clean authentic shell chrome) -->
    <div
      class="max-w-4xl mx-auto rounded-2xl bg-[#090d16] border border-slate-800 shadow-2xl terminal-shadow overflow-hidden"
      data-lang={lang}
      data-copied-text={t.copied}
      data-copy-text={t.copyOutput}
    >
      <!-- Titlebar -->
      <div class="bg-[#121624] px-4 py-3 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
          <span id="demo-active-title" class="ml-2 font-mono text-xs text-slate-300 font-medium">ask "como ver puertos y procesos"</span>
        </div>
        <div class="flex items-center gap-3">
          <span id="demo-os-tag" class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700 hidden sm:inline">
            Host: Auto
          </span>
          <span id="demo-active-badge" class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hidden sm:inline">
            Dilix Copilot
          </span>
          <button
            id="demo-copy-output"
            class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-800/60 hover:bg-slate-800 border border-slate-700/60 transition-all cursor-pointer"
            title={t.copyOutput}
          >
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="demo-copy-feedback">{t.copyOutput}</span>
          </button>
        </div>
      </div>

      <!-- Real Terminal GIF Screen Area -->
      <div id="terminal-screen" class="relative bg-[#16161e] overflow-hidden min-h-[300px]">
        <img
          id="demo-terminal-gif"
          src={`/${lang}/hero-ask.gif`}
          alt="Dilix terminal recording preview"
          class="w-full h-auto block select-none transition-opacity duration-200"
          loading="eager"
          width="1200"
          height="680"
        />

        <div id="demo-terminal-placeholder" class="hidden min-h-[320px] flex flex-col items-center justify-center p-8 text-center bg-[#16161e] space-y-3 font-mono">
          <div class="text-slate-500 text-sm">
            {lang === 'en' ? 'Terminal session cleared.' : 'Sesión de terminal reiniciada.'}
          </div>
          <div class="text-xs text-slate-400">
            {lang === 'en' ? 'Click any preset command above or type below to replay real execution.' : 'Haz clic en cualquier comando arriba o escribe abajo para ver la ejecución real.'}
          </div>
        </div>
      </div>

      <!-- Bottom Interactive Input bar -->
      <div class="p-3 bg-[#0d121f] border-t border-slate-800 flex items-center gap-2">
        <span class="text-emerald-400 font-mono font-bold text-sm pl-2">❯</span>
        <input
          id="terminal-custom-input"
          type="text"
          placeholder={t.inputPlaceholder}
          class="w-full bg-transparent border-0 text-slate-200 placeholder-slate-500 font-mono text-xs sm:text-sm focus:outline-none focus:ring-0"
        />
        <span class="text-[10px] font-mono text-slate-500 pr-2 shrink-0 hidden sm:inline">{t.enterHint}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.querySelector('[data-lang]');
  const currentLang = container?.getAttribute('data-lang') || 'es';
  const copiedLabel = container?.getAttribute('data-copied-text') || '¡Copiado!';
  const copyLabel = container?.getAttribute('data-copy-text') || 'Copiar Comando';

  const demoData = {
    ask: {
      gif: `/${currentLang}/hero-ask.gif`,
      cmd: currentLang === 'en' ? 'ask "how to find listening ports and their processes"' : 'ask "como ver puertos y procesos escuchando en el sistema"',
      title: currentLang === 'en' ? 'ask "how to find listening ports..."' : 'ask "como ver puertos y procesos..."',
      badge: 'Dilix Copilot'
    },
    fix: {
      gif: `/${currentLang}/feature-fix.gif`,
      cmd: 'fix',
      title: 'fix — Error auto-diagnosis (Ctrl + G)',
      badge: 'Auto-Diagnosis'
    },
    menu: {
      gif: `/${currentLang}/feature-menu.gif`,
      cmd: 'dilix menu',
      title: 'dilix menu — Interactive CLI Hub',
      badge: 'Interactive Menu'
    },
    ff: {
      gif: `/${currentLang}/feature-terminal.gif`,
      cmd: 'ff',
      title: 'ff — Tokyo Night & Fastfetch',
      badge: 'Terminal Showcase'
    },
    explain: {
      gif: `/${currentLang}/feature-explain.gif`,
      cmd: 'dilix explain "git rebase -i HEAD~3"',
      title: 'dilix explain "git rebase -i HEAD~3"',
      badge: 'Code Explanation'
    }
  };

  const gifElement = document.getElementById('demo-terminal-gif') as HTMLImageElement | null;
  const placeholderElement = document.getElementById('demo-terminal-placeholder');
  const activeTitle = document.getElementById('demo-active-title');
  const activeBadge = document.getElementById('demo-active-badge');
  const cmdBtns = document.querySelectorAll('.demo-cmd-btn');
  const clearBtn = document.getElementById('demo-clear-btn');
  const customInput = document.getElementById('terminal-custom-input') as HTMLInputElement | null;
  const copyOutputBtn = document.getElementById('demo-copy-output');
  const copyFeedback = document.getElementById('demo-copy-feedback');

  let currentActiveCmd = 'ask';

  function switchCommand(cmdKey: string) {
    const data = demoData[cmdKey as keyof typeof demoData] || demoData.ask;
    currentActiveCmd = cmdKey in demoData ? cmdKey : 'ask';

    if (gifElement) {
      gifElement.classList.add('opacity-0');
      setTimeout(() => {
        gifElement.src = data.gif;
        gifElement.classList.remove('opacity-0');
      }, 100);

      if (placeholderElement) {
        placeholderElement.classList.add('hidden');
        gifElement.classList.remove('hidden');
      }
    }

    if (activeTitle) activeTitle.textContent = data.title;
    if (activeBadge) activeBadge.textContent = data.badge;

    cmdBtns.forEach(btn => {
      const btnCmd = btn.getAttribute('data-demo-cmd');
      if (btnCmd === cmdKey) {
        btn.classList.add('bg-emerald-500', 'text-slate-950', 'font-bold', 'border-emerald-400', 'shadow-md', 'shadow-emerald-500/20');
        btn.classList.remove('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
      } else {
        btn.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold', 'border-emerald-400', 'shadow-md', 'shadow-emerald-500/20');
        btn.classList.add('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
      }
    });
  }

  // Button clicks
  cmdBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-demo-cmd');
      if (cmd) switchCommand(cmd);
    });
  });

  // Clear button
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (gifElement && placeholderElement) {
        gifElement.classList.add('hidden');
        placeholderElement.classList.remove('hidden');
      }
      if (activeTitle) activeTitle.textContent = currentLang === 'en' ? 'Session cleared' : 'Sesión reiniciada';
      if (activeBadge) activeBadge.textContent = 'Idle';
      cmdBtns.forEach(b => {
        b.classList.remove('bg-emerald-500', 'text-slate-950', 'font-bold', 'border-emerald-400', 'shadow-md', 'shadow-emerald-500/20');
        b.classList.add('bg-slate-900/80', 'text-slate-300', 'border-slate-800');
      });
    });
  }

  // Input listener
  if (customInput) {
    customInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = customInput.value.trim().toLowerCase();
        if (!val) return;

        if (val.includes('fix')) switchCommand('fix');
        else if (val.includes('menu')) switchCommand('menu');
        else if (val.includes('ff') || val.includes('fastfetch') || val.includes('term')) switchCommand('ff');
        else if (val.includes('explain') || val.includes('rebase')) switchCommand('explain');
        else if (val === 'clear') {
          if (clearBtn) clearBtn.click();
        } else {
          switchCommand('ask');
          if (activeTitle) activeTitle.textContent = customInput.value;
        }
        customInput.value = '';
      }
    });
  }

  // Copy command
  if (copyOutputBtn && copyFeedback) {
    copyOutputBtn.addEventListener('click', async () => {
      const activeData = demoData[currentActiveCmd as keyof typeof demoData] || demoData.ask;
      try {
        await navigator.clipboard.writeText(activeData.cmd);
        copyFeedback.textContent = copiedLabel;
        copyOutputBtn.classList.add('border-emerald-500', 'text-emerald-400');
        setTimeout(() => {
          copyFeedback.textContent = copyLabel;
          copyOutputBtn.classList.remove('border-emerald-500', 'text-emerald-400');
        }, 2000);
      } catch (err) {
        console.error('Error copying command:', err);
      }
    });
  }

  // Detect Host OS for titlebar tag
  try {
    const ua = (navigator.userAgent || '').toLowerCase();
    const plat = (((navigator as any).userAgentData?.platform) || navigator.platform || '').toLowerCase();
    const osTag = document.getElementById('demo-os-tag');
    if (osTag) {
      if (plat.includes('mac') || ua.includes('macintosh') || ua.includes('mac os x')) {
        osTag.textContent = 'Host: macOS (Darwin)';
      } else if (plat.includes('win') || ua.includes('windows')) {
        osTag.textContent = 'Host: WSL2 (Windows)';
      } else if (ua.includes('cachyos') || ua.includes('arch')) {
        osTag.textContent = 'Host: CachyOS / Arch';
      } else if (ua.includes('ubuntu') || ua.includes('debian')) {
        osTag.textContent = 'Host: Ubuntu Linux';
      } else {
        osTag.textContent = 'Host: Linux / Unix';
      }
    }
  } catch (e) {}
</script>
