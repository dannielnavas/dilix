---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = translations[lang].demo;
---

<section id="demo" class="py-24 relative overflow-hidden bg-[#070b13]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        {t.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        {t.title}
      </h2>
      <p class="mt-4 text-slate-400 text-base sm:text-lg">
        {t.subtitle}
      </p>

      <!-- Command Quick Selection Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
        <button
          type="button"
          data-demo-cmd="ask"
          class="demo-cmd-btn active px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-indigo-600 text-white border-indigo-500 shadow-md shadow-indigo-600/30"
        >
          {t.btnAsk}
        </button>
        <button
          type="button"
          data-demo-cmd="fix"
          class="demo-cmd-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnFix}
        </button>
        <button
          type="button"
          data-demo-cmd="menu"
          class="demo-cmd-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnMenu}
        </button>
        <button
          type="button"
          data-demo-cmd="ff"
          class="demo-cmd-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border transition-all cursor-pointer bg-slate-900 text-slate-300 border-slate-800 hover:border-slate-700 hover:text-white"
        >
          {t.btnFf}
        </button>
        <button
          type="button"
          id="demo-clear-btn"
          class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-medium border border-rose-500/20 text-rose-400 hover:bg-rose-500/10 transition-all cursor-pointer"
        >
          {t.btnClear}
        </button>
      </div>
    </div>

    <!-- Terminal Window Container -->
    <div
      class="max-w-4xl mx-auto rounded-2xl bg-[#090d16] border border-slate-800 shadow-2xl terminal-shadow overflow-hidden"
      data-lang={lang}
      data-copied-text={t.copied}
      data-copy-text={t.copyOutput}
    >
      <!-- Titlebar -->
      <div class="bg-[#0f1422] px-4 py-3 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
          <span class="ml-2 font-mono text-xs text-slate-400">dilix-session — wezterm interactive</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-[11px] font-mono text-slate-400 hidden sm:inline">Ctrl + G {lang === 'en' ? 'for self-diagnosis' : 'para autodiagnóstico'}</span>
          <button
            id="demo-copy-output"
            class="text-xs text-slate-400 hover:text-white flex items-center gap-1 transition-colors cursor-pointer"
            title={t.copyOutput}
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span id="demo-copy-feedback">{t.copyOutput}</span>
          </button>
        </div>
      </div>

      <!-- Terminal Body -->
      <div id="terminal-screen" class="p-6 font-mono text-xs sm:text-sm text-slate-200 min-h-[380px] max-h-[520px] overflow-y-auto space-y-4">
        <!-- Dynamically populated by JS -->
      </div>

      <!-- Bottom Interactive Input bar -->
      <div class="p-3 bg-[#0d121f] border-t border-slate-800 flex items-center gap-2">
        <span class="text-emerald-400 font-mono font-bold text-sm pl-2">❯</span>
        <input
          id="terminal-custom-input"
          type="text"
          placeholder={t.inputPlaceholder}
          class="w-full bg-transparent border-0 text-slate-200 placeholder-slate-500 font-mono text-xs sm:text-sm focus:outline-none focus:ring-0"
        />
        <span class="text-[10px] font-mono text-slate-500 pr-2 shrink-0 hidden sm:inline">{t.enterHint}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.querySelector('[data-lang]');
  const currentLang = container?.getAttribute('data-lang') || 'es';
  const copiedLabel = container?.getAttribute('data-copied-text') || '¡Copiado!';
  const copyLabel = container?.getAttribute('data-copy-text') || 'Copiar';

  const demoOutputsEs = {
    ask: `
<div class="flex items-center gap-2 text-indigo-400 font-bold">
  <span>danniel@workstation</span> <span class="text-slate-500">in</span> <span class="text-cyan-300">~/projects</span> <span class="text-emerald-400">❯</span>
  <span class="text-amber-300 font-normal">ask "como buscar archivos modificados en las últimas 24 horas"</span>
</div>
<div class="p-4 rounded-xl bg-slate-900/90 border border-indigo-500/40 space-y-3 mt-2 shadow-lg">
  <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
    <span class="text-cyan-400 font-bold flex items-center gap-2">
      <span>🧠</span> Dilix Copilot • qwen2.5-coder:1.5b
    </span>
    <span class="text-[11px] text-slate-400">Latencia: 180ms • Local IPC</span>
  </div>
  <p class="text-slate-300">
    Comando optimizado usando <span class="text-cyan-300 font-semibold">find</span> con filtro de tiempo relativo:
  </p>
